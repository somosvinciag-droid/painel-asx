<?xml version="1.0" encoding="utf-8"?>
<!--
  Versao leve: so escuta quando uma TELA nova abre (nao cada mudancinha dentro dela).
  Ler todos os detalhes da tela so acontece quando alguem pede (comando "lê a tela").
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/descricao_acessibilidade"
    android:notificationTimeout="300" />
